@{
    ViewBag.Title = "Главная - HeadHunter";
    Layout = "_Layout";
}
<h1>@(User.IsInRole("user") ? "Вакансии" : "Резюме")</h1>
<div class="container py-4">
    <div id="contentContainer" class="row justify-content-center">
   
    </div>
</div>

@section Scripts {
    <script>
        let listContainer = $('#contentContainer');
        $(document).ready(function () {
            @if (User.IsInRole("user"))
            {
                <text>
                    listContainer.load('@Url.Action("GetVacancies", "Main")')
                </text>
            }
            else if (User.IsInRole("company")) 
            {
                <text>
                    listContainer.load('@Url.Action("Published", "Resume")')
                </text>
            }
            else 
            {
                <text>
                    listContainer.load('@Url.Action("GetVacancies", "Main")')
                </text>
            }
        });
    </script>
}
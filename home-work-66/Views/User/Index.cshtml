@model home_work_66.Models.User

@{
    ViewData["Title"] = "Личный кабинет";

    var resumes = ViewBag.Resumes as List<home_work_66.Models.Resume>
                  ?? new List<home_work_66.Models.Resume>();
}

<div class="container py-4">

    <div class="row">

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">

                    <img src="@Model.AvatarUrl" alt="Аватар" class="rounded-circle mb-3" width="130" height="130" style="object-fit: cover;" />

                    <h3 class="mb-3">
                        @Model.UserName
                    </h3>

                    <p class="text-muted mb-2">
                        @Model.Email
                    </p>

                    <p class="text-muted mb-4">
                        @Model.PhoneNumber
                    </p>

                    <button class="btn btn-outline-primary w-100" type="button" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                        Редактировать профиль
                    </button>

                </div>
            </div>
        </div>

        <div class="col-md-8">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">
                    Мои резюме
                </h2>

                <a asp-controller="Resume" asp-action="Create" class="btn btn-primary">
                    Создать резюме
                </a>
            </div>

            @if (resumes.Count == 0)
            {
                <div class="card shadow-sm border-0 w-100">
                    <div class="card-body">
                        <p class="text-muted mb-0">
                            У вас пока нет созданных резюме.
                        </p>
                    </div>
                </div>
            }
            else
            {
                @foreach (var resume in resumes)
                {
                    <div class="card shadow-sm border-0 mb-3 w-100">
                        <div class="card-body">

                            <h5 class="card-title mb-2">
                                @resume.Title
                            </h5>

                            <p class="text-muted mb-2">
                                Обновлено: @resume.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </p>

                            <div class="mb-3">
                                @if (resume.IsPublished)
                                {
                                    <span class="badge bg-success">Опубликовано</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Не опубликовано</span>
                                }
                            </div>

                            <div>
                                <button class="btn btn-outline-primary btn-sm" type="button">
                                    Редактировать
                                </button>
                                
                                <a asp-controller="Resume" asp-action="AddWorkExperience" asp-route-resumeId="@resume.Id" class="btn btn-outline-primary btn-sm">
                                    Добавить опыт
                                </a>
                                
                                <a asp-controller="Resume" asp-action="AddEducation" asp-route-resumeId="@resume.Id" class="btn btn-outline-primary btn-sm">
                                    Добавить образование
                                </a>
                                
                                <form asp-controller="Resume" asp-action="UpdateDate" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@resume.Id" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Обновить</button>
                                </form>
                                
                            </div>

                        </div>
                    </div>
                }
            }

        </div>

    </div>

    @{
        var editProfileModel = new home_work_66.ViewModels.EditProfileViewModel
        {
            UserName = Model.UserName ?? "",
            Email = Model.Email ?? "",
            PhoneNumber = Model.PhoneNumber ?? ""
        };
    }

    <partial name="_EditProfileModal" model="editProfileModel" />

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @if (ViewBag.OpenEditProfileModal == true)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const modalElement = document.getElementById("editProfileModal");
                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            });
        </script>
    }
}
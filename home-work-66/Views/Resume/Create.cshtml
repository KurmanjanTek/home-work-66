@model home_work_66.Models.Resume

@{
    ViewData["Title"] = "Создание резюме";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h2 class="mb-4">Создать резюме</h2>

                    <form asp-controller="Resume" asp-action="Create" method="post">

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Название резюме <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Например: Backend Developer" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                            
                             <div class="mb-3">
                                 <label asp-for="Category" class="form-label">Категория вакансии <span class="text-danger">*</span></label>
                                 <span asp-validation-for="Category" class="text-danger"></span>
                                 <select asp-for="Category" class="form-select">
                                     <option value="">Выберите категорию</option>
                                     <option value="IT">IT</option>
                                     <option value="Продажи">Продажи</option>
                                     <option value="Маркетинг">Маркетинг</option>
                                     <option value="Финансы">Финансы</option>
                                     <option value="Образование">Образование</option>
                                     <option value="Другое">Другое</option>
                                 </select>
                                 
                             </div>

                        <div class="mb-3">
                            <label asp-for="Salary" class="form-label">Ожидаемая зарплата <span class="text-danger">*</span></label>
                            <input asp-for="Salary" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Salary" class="text-danger"></span>
                        </div>

                        <h5 class="mt-4 mb-3">Контактные данные</h5>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Номер телефона</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Telegram" class="form-label">Telegram</label>
                            <input asp-for="Telegram" class="form-control" placeholder="Telegram username">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Facebook" class="form-label">Facebook</label>
                            <input asp-for="Facebook" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="LinkedIn" class="form-label">LinkedIn</label>
                            <input asp-for="LinkedIn" class="form-control" />
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Создать</button>


                            <a asp-controller="User" asp-action="Index" class="btn btn-secondary">
                                Отмена
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>
@model home_work_66.Models.Resume

@{
    ViewData["Title"] = "Создание резюме";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h2 class="mb-4">Создать резюме</h2>

                    <form asp-controller="Resume" asp-action="Create" method="post">

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Название резюме</label>
                            <input asp-for="Title" class="form-control" placeholder="Например: Backend Developer" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Создать</button>

                            <a asp-controller="User" asp-action="Index" class="btn btn-secondary">
                                Отмена
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>
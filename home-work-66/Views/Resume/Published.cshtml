@model List<home_work_66.Models.Resume>

@{
    ViewData["Title"] = "Резюме";
}

<div class="container py-4">

    <h2 class="mb-4">Резюме соискателей</h2>

    @if (Model.Count == 0)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <p class="text-muted mb-0">Опубликованных резюме пока нет.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var resume in Model)
        {
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body">

                    <h5 class="card-title">@resume.Title</h5>

                    <p class="mb-1">
                        <strong>Категория:</strong> @resume.Category?.Name
                    </p>

                    @if (resume.Salary != null)
                    {
                        <p class="mb-1">
                            <strong>Ожидаемая зарплата:</strong> @resume.Salary
                        </p>
                    }

                    <p class="text-muted mb-3">
                        Обновлено: @resume.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </p>

                    <a asp-controller="Resume" asp-action="PublicDetails" asp-route-id="@resume.Id" class="btn btn-outline-primary btn-sm">
                        Посмотреть резюме
                    </a>

                </div>
            </div>
        }
    }

</div>